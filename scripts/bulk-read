#!/bin/bash
# Delegate file reading to the kirunt-bulk-reader worker agent.
# Usage: bulk-read --question "what does this do?" --paths file1.ts file2.ts

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/kirunt.sh
. "$SCRIPT_DIR/lib/kirunt.sh"

AGENT_NAME="kirunt-bulk-reader"

# Defense in depth: the check-file-size/check-bash-read hooks already skip
# blocking when this is false, but the model — or a human — could still
# call this script directly. Refuse rather than silently delegating.
if [ "$KIRUNT_ENABLE_BULK_READER" = "false" ]; then
  echo "Error: bulk-read is disabled (KIRUNT_ENABLE_BULK_READER=false)." >&2
  exit 1
fi

question=""
paths=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --question) question="$2"; shift 2 ;;
    --paths)    shift; while [[ $# -gt 0 && ! "$1" =~ ^-- ]]; do paths+=("$1"); shift; done ;;
    *)          shift ;;
  esac
done

if [ -z "$question" ]; then
  echo "Error: --question is required" >&2
  exit 1
fi

if [ ${#paths[@]} -eq 0 ]; then
  echo "Error: --paths is required" >&2
  exit 1
fi

# A typo'd path would be sent as an empty <file> block and produce a
# confident answer about nothing — fail loudly instead.
for path in "${paths[@]}"; do
  if [ ! -f "$path" ] || [ ! -r "$path" ]; then
    echo "Error: file not found or unreadable: $path" >&2
    exit 1
  fi
done

kirunt_preflight || exit 1
kirunt_tmpfile message_file || exit 1

# Wrap each file in XML tags so the model sees clear boundaries. Stream
# straight into the message file: no corpus-sized shell variable, and file
# contents survive byte-for-byte.
for path in "${paths[@]}"; do
  {
    printf '<file path="%s">\n' "$path"
    cat "$path"
    printf '</file>\n\n'
  } >> "$message_file"
done
printf 'Question: %s\n' "$question" >> "$message_file"

kirunt_invoke "$AGENT_NAME" "$message_file" || exit 1

# Token usage to stderr
char_count=$(wc -c < "$message_file" | tr -d ' ')
echo "[kirunt: ~$((char_count / 4)) input tokens | delegated to $AGENT_NAME ($KIRUNT_WORKER_MODEL)]" >&2
